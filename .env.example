# Vertex Gemini 2.5 Flash on AMER SC sandbox
GOOGLE_CLOUD_PROJECT=project-amer-scs-sandbox
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Browserbase cloud browser (required for cloud sessions)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Google AI Studio (Gemini for open-source Browser Use)
GOOGLE_API_KEY=

# Pioneer by Fastino Labs (open-weight verdict extraction + GLiNER2)
PIONEER_API_KEY=
PIONEER_DECODER_MODEL=Qwen/Qwen3-8B

# Shopper model profile: gemini | gemini_sft | qwen | frontier
SHOPPER_MODEL=gemini
GEMINI_SFT_ENDPOINT=projects/347838016394/locations/us-central1/endpoints/1173650047569494016

# Terac human studies (general population)
TERAC_API_KEY=
TERAC_PROJECT_ID=
TERAC_ATELIER_URL=https://terac.com/atelier-msuo0cw0
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Vercel: point live panels at your worker (local or Railway)
# PANEL_WORKER_URL=https://your-worker.example.com

# Stripe — hackathon Agent-Run Company track
# Run: STRIPE_SECRET_KEY=sk_test_... .venv/bin/python scripts/setup_stripe.py --team "Your Team"
STRIPE_PAYMENT_LINK=
# Optional display name for setup_stripe.py (--team overrides)
# STRIPE_TEAM_NAME=Shopper Panel

# Optional: headed local Chromium while debugging
# SIM_HEADED=1
